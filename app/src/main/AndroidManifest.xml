<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Local audio access permissions across Android versions -->
    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO" />
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <!-- Background media playback and notification controls -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:name=".MikaApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Mika">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Mika">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" android:mimeType="audio/*" />
                <data android:scheme="file" android:mimeType="audio/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" android:mimeType="video/*" />
                <data android:scheme="file" android:mimeType="video/*" />
            </intent-filter>
        </activity>

        <!-- Dynamic Launcher Icon Presets -->
        <activity-alias
            android:name=".MainLauncherAurora"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_aurora"
            android:roundIcon="@mipmap/ic_launcher_aurora"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".MainLauncherMono"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_mono"
            android:roundIcon="@mipmap/ic_launcher_mono"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".MainLauncherViolet"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_violet"
            android:roundIcon="@mipmap/ic_launcher_violet"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".MainLauncherNeon"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_neon"
            android:roundIcon="@mipmap/ic_launcher_neon"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <activity-alias
            android:name=".MainLauncherClassic"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_classic"
            android:roundIcon="@mipmap/ic_launcher_classic"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <service
            android:name=".playback.MikaPlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
                <action android:name="android.media.browse.MediaBrowserService" />
            </intent-filter>
        </service>

        <receiver
            android:name=".widget.MikaMusicWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="dev.sagor.mika.WIDGET_PLAY_PAUSE" />
                <action android:name="dev.sagor.mika.WIDGET_NEXT" />
                <action android:name="dev.sagor.mika.WIDGET_PREV" />
                <action android:name="dev.sagor.mika.WIDGET_STOP" />
                <action android:name="dev.sagor.mika.WIDGET_FAVORITE" />
                <action android:name="dev.sagor.mika.WIDGET_REPEAT" />
                <action android:name="dev.sagor.mika.WIDGET_SHUFFLE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/mika_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.MikaCompactWidgetProvider"
            android:exported="true"
            android:label="Mika Compact (2x1)">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="dev.sagor.mika.WIDGET_PLAY_PAUSE" />
                <action android:name="dev.sagor.mika.WIDGET_NEXT" />
                <action android:name="dev.sagor.mika.WIDGET_PREV" />
                <action android:name="dev.sagor.mika.WIDGET_STOP" />
                <action android:name="dev.sagor.mika.WIDGET_FAVORITE" />
                <action android:name="dev.sagor.mika.WIDGET_REPEAT" />
                <action android:name="dev.sagor.mika.WIDGET_SHUFFLE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/mika_compact_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.MikaExpandedWidgetProvider"
            android:exported="true"
            android:label="Mika Album Card (4x2)">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="dev.sagor.mika.WIDGET_PLAY_PAUSE" />
                <action android:name="dev.sagor.mika.WIDGET_NEXT" />
                <action android:name="dev.sagor.mika.WIDGET_PREV" />
                <action android:name="dev.sagor.mika.WIDGET_STOP" />
                <action android:name="dev.sagor.mika.WIDGET_FAVORITE" />
                <action android:name="dev.sagor.mika.WIDGET_REPEAT" />
                <action android:name="dev.sagor.mika.WIDGET_SHUFFLE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/mika_expanded_widget_info" />
        </receiver>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
