<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="4dp">

    <ImageView
        android:id="@+id/widget_bg_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitXY" />

    <LinearLayout
        android:id="@+id/widget_content_row"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="12dp"
        android:paddingBottom="10dp">

        <ImageView
            android:id="@+id/widget_artwork"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:contentDescription="@string/widget_artwork_desc"
            android:scaleType="centerCrop" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="4dp">

            <TextView
                android:id="@+id/widget_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/app_name"
                android:textColor="#FFFFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#CCFFFFFF"
                android:textSize="12sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/widget_controls_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/widget_btn_favorite"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/widget_action_favorite"
                    android:padding="6dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_notif_heart_outline"
                    android:visibility="gone" />

                <ImageButton
                    android:id="@+id/widget_btn_shuffle"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/widget_action_shuffle"
                    android:padding="6dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_widget_shuffle"
                    android:visibility="gone" />

                <ImageButton
                    android:id="@+id/widget_btn_prev"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/widget_action_prev"
                    android:padding="6dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_widget_prev" />

                <ImageButton
                    android:id="@+id/widget_btn_play_pause"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/widget_action_play_pause"
                    android:padding="5dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_widget_play" />

                <ImageButton
                    android:id="@+id/widget_btn_next"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/widget_action_next"
                    android:padding="6dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_widget_next" />

                <ImageButton
                    android:id="@+id/widget_btn_repeat"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/widget_action_repeat"
                    android:padding="6dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_widget_repeat"
                    android:visibility="gone" />

                <ImageButton
                    android:id="@+id/widget_btn_stop"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@android:color/transparent"
                    android:contentDescription="@string/widget_action_stop"
                    android:padding="6dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_widget_stop" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
